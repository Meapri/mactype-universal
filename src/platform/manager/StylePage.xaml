<!-- StylePage.xaml - Styles & Profiles Page -->
<Page
    x:Class="MacTypeManager.StylePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MacTypeManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Style Gallery -->
        <StackPanel Grid.Column="0" Margin="16" Spacing="16">
            <TextBlock
                Text="Style Gallery"
                Style="{StaticResource HeaderTextBlockStyle}"
                FontSize="20"
                FontWeight="SemiBold"/>
            <TextBlock
                Text="Choose from built-in rendering styles"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <GridView
                    x:Name="StyleGridView"
                    ItemTemplate="{StaticResource StyleItemTemplate}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True">
                    <!-- Style items will be populated programmatically -->
                </GridView>
            </Border>
        </StackPanel>

        <!-- Preview Panel -->
        <StackPanel Grid.Column="1" Margin="16" Spacing="16">
            <TextBlock
                Text="Live Preview"
                Style="{StaticResource HeaderTextBlockStyle}"
                FontSize="20"
                FontWeight="SemiBold"/>
            <TextBlock
                Text="See how the selected style looks"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Height="300">
                <ScrollViewer>
                    <StackPanel x:Name="PreviewPanel" Spacing="12">
                        <!-- Preview content will be generated here -->
                        <TextBlock Text="Preview will be implemented here" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Apply Style" Style="{StaticResource AccentButtonStyle}" MinWidth="100"/>
                <Button Content="Save Profile" MinWidth="100"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
