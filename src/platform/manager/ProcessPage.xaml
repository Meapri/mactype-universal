<!-- ProcessPage.xaml - Process Manager Page -->
<Page
    x:Class="MacTypeManager.ProcessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MacTypeManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="16,16,16,8">
            <TextBlock
                Text="Process Manager"
                Style="{StaticResource HeaderTextBlockStyle}"
                FontSize="24"
                FontWeight="SemiBold"/>
            <TextBlock
                Text="Monitor and manage running processes with MacType injection"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Process List -->
        <StackPanel Grid.Row="1" Margin="16" Spacing="16">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Running Processes"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        FontSize="16"/>

                    <!-- Process list will be implemented here -->
                    <ListView
                        x:Name="ProcessListView"
                        Height="300"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="8">
                                    <FontIcon Glyph="&#xE8BB;" FontSize="16"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Process Name" FontWeight="SemiBold"/>
                                        <TextBlock Text="PID: 1234 | Status: Injected"
                                                 FontSize="12"
                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh" MinWidth="80"/>
                        <Button Content="Inject Selected" MinWidth="120" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Batch Inject" MinWidth="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
