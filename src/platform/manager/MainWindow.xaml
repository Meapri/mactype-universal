<!-- MainWindow.xaml - MacType Manager Main Interface -->
<Window
    x:Class="MacTypeManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MacTypeManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="NavigationViewControl"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            SelectionChanged="NavigationView_SelectionChanged">

            <NavigationView.MenuItems>
                <!-- Start Mode Section -->
                <NavigationViewItem
                    x:Name="ModePageItem"
                    Icon="Play"
                    Content="Start Mode"
                    Tag="ModePage"
                    IsSelected="True"/>

                <!-- Process Manager Section -->
                <NavigationViewItem
                    x:Name="ProcessPageItem"
                    Icon="AllApps"
                    Content="Process Manager"
                    Tag="ProcessPage"/>

                <!-- Style & Profile Section -->
                <NavigationViewItem
                    x:Name="StylePageItem"
                    Icon="Color"
                    Content="Styles & Profiles"
                    Tag="StylePage"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Orientation="Vertical" Margin="8">
                    <Button
                        x:Name="SettingsButton"
                        Content="Settings"
                        Click="SettingsButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,0,8"/>
                    <Button
                        x:Name="AboutButton"
                        Content="About"
                        Click="AboutButton_Click"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- Main Content Frame -->
            <Frame
                x:Name="ContentFrame"
                Margin="0"
                IsNavigationUIVisibility="Automatic"/>
        </NavigationView>
    </Grid>
</Window>
