<!-- App.xaml - MacType Manager Application Resources -->
<Application
    x:Class="MacTypeManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MacTypeManager"
    RequestedTheme="Default">

    <Application.Resources>
        <!-- Modern color palette -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light theme -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4"/>
                    <SolidColorBrush x:Key="SecondaryBrush" Color="#106EBE"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#FF8C00"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#D13438"/>
                </ResourceDictionary>

                <!-- Dark theme -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#60CDFF"/>
                    <SolidColorBrush x:Key="SecondaryBrush" Color="#0078D4"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#106EBE"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#92C5F6"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Font resources -->
            <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
            <FontFamily x:Key="PivotHeaderItemFontFamily">Segoe UI</FontFamily>

            <!-- Spacing -->
            <Thickness x:Key="DefaultMargin">8</Thickness>
            <Thickness x:Key="LargeMargin">16</Thickness>
            <Thickness x:Key="SmallMargin">4</Thickness>

            <!-- Corner radius -->
            <CornerRadius x:Key="DefaultCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="LargeCornerRadius">8</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
