name: Build MacType

on:
  push:
    branches: [ "main", "directwrite", "develop" ]
  pull_request:
    branches: [ "main", "directwrite" ]
  release:
    types: [published]
  workflow_dispatch:

concurrency:
  group: build-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  static-analysis:
    name: Static Analysis
    runs-on: windows-latest
    timeout-minutes: 30

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup MSVC
      uses: microsoft/setup-msbuild@v2

    - name: Check code quality with MSVC analyzer
      run: |
        # Create a simple analysis using MSVC compiler warnings
        mkdir build-analysis
        cd build-analysis
        cmake .. -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="/analyze /analyze:stacksize 16384 /analyze:max_paths 256"
        cmake --build . --config Debug -- /p:RunCodeAnalysis=true 2>&1 | tee msvc-analysis.log || true

    - name: Upload analysis results
      uses: actions/upload-artifact@v4
      with:
        name: static-analysis-results
        path: |
          build-analysis/msvc-analysis.log
        retention-days: 7

  build:
    runs-on: windows-latest
    timeout-minutes: 90
    needs: static-analysis

    strategy:
      fail-fast: false
      matrix:
        platform: [x86, x64]  # ARM64 임시 제외
        configuration: [Release, Debug]

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup MSBuild
      uses: microsoft/setup-msbuild@v2

    - name: Add Windows SDK to PATH and set compatible SDK version
      run: |
        echo "=== 설치된 Windows SDK 버전들 ==="
        $sdkVersions = Get-ChildItem "${env:ProgramFiles(x86)}\Windows Kits\10\Include\" -Directory -ErrorAction SilentlyContinue | Sort-Object Name
        $sdkVersions | ForEach-Object { echo "  - $($_.Name)" }
        $preferredVersions = @("10.0.26100.0", "10.0.22621.0", "10.0.22000.0", "10.0.20348.0", "10.0.19041.0")
        $selectedSdk = $null
        foreach ($version in $preferredVersions) {
          $sdkIncludePath = "${env:ProgramFiles(x86)}\Windows Kits\10\Include\$version"
          if (Test-Path $sdkIncludePath) { $selectedSdk = $version; echo "선택된 Windows SDK: $version"; break }
        }
        if (-not $selectedSdk -and $sdkVersions) {
          $newestSdk = $sdkVersions | Where-Object { $_.Name -match "^\d+\.\d+\.\d+\.\d+$" } | Sort-Object Name -Descending | Select-Object -First 1
          if ($newestSdk) { $selectedSdk = $newestSdk.Name; echo "최신 Windows SDK 사용: $selectedSdk" } else { $selectedSdk = $sdkVersions[0].Name; echo "기본 Windows SDK 사용: $selectedSdk" }
        }
        if ($selectedSdk) {
          echo "WindowsSDKVersion=$selectedSdk" >> $env:GITHUB_ENV
          echo "WINDOWS_SDK_VERSION=$selectedSdk" >> $env:GITHUB_ENV
          # 플랫폼별 SDK bin 경로 설정
          $sdkBinPath = switch ("${{ matrix.platform }}") {
            "x86" { "${env:ProgramFiles(x86)}\Windows Kits\10\bin\$selectedSdk\x86" }
            "x64" { "${env:ProgramFiles(x86)}\Windows Kits\10\bin\$selectedSdk\x64" }
            "ARM64" { "${env:ProgramFiles(x86)}\Windows Kits\10\bin\$selectedSdk\x64" }  # ARM64 크로스컴파일
            default { "${env:ProgramFiles(x86)}\Windows Kits\10\bin\$selectedSdk\x64" }
          }
          if (Test-Path $sdkBinPath) { echo "$sdkBinPath" >> $env:GITHUB_PATH }
        }
        echo "=== Visual Studio 설치 확인 ==="
        Get-ChildItem "${env:ProgramFiles}\Microsoft Visual Studio\2022\" -ErrorAction SilentlyContinue
        Get-ChildItem "${env:ProgramFiles(x86)}\Microsoft Visual Studio\" -ErrorAction SilentlyContinue

    - name: Cache dependencies
      uses: actions/cache@v4
      with:
        path: |
          lib/
          deps/
        key: ${{ runner.os }}-deps-${{ hashFiles('**/HOWTOBUILD.md') }}
        restore-keys: |
          ${{ runner.os }}-deps-

    - name: Create directories
      run: |
        New-Item -ItemType Directory -Force -Path lib
        New-Item -ItemType Directory -Force -Path deps

    - name: Cache vcpkg
      uses: actions/cache@v4
      with:
        path: |
          vcpkg
          vcpkg/installed
        key: vcpkg-${{ matrix.platform }}-${{ hashFiles('vcpkg.json', 'vcpkg-configuration.json') }}
        restore-keys: |
          vcpkg-${{ matrix.platform }}-
          vcpkg-

    - name: Setup vcpkg
      run: |
        if (!(Test-Path "vcpkg")) { git clone https://github.com/Microsoft/vcpkg.git vcpkg }
        cd vcpkg
        if (!(Test-Path "vcpkg.exe")) { .\bootstrap-vcpkg.bat }
        echo "VCPKG_ROOT=$PWD" >> $env:GITHUB_ENV
        echo "$PWD" >> $env:GITHUB_PATH
        cd ..

    - name: Install detours and deps via vcpkg (manifest)
      run: |
        # 플랫폼별 triplet 설정 (더 정확한 매핑)
        $triplet = switch ("${{ matrix.platform }}") {
          "x86" { "x86-windows" }
          "x64" { "x64-windows" }
          "ARM64" { "arm64-windows" }
          default { "x64-windows" }
        }
        # 플랫폼별 MSBuild 플랫폼 이름 매핑
        $msbuildPlatform = switch ("${{ matrix.platform }}") {
          "x86" { "Win32" }
          "x64" { "x64" }
          "ARM64" { "ARM64" }
          default { "x64" }
        }

        # 플랫폼별 호스트 아키텍처 설정 (ARM64 크로스컴파일용)
        $hostArch = switch ("${{ matrix.platform }}") {
          "x86" { "x86" }
          "x64" { "x64" }
          "ARM64" { "x64" }  # ARM64는 x64 호스트에서 크로스컴파일
          default { "x64" }
        }
        # 플랫폼별 라이브러리 접미사
        $libSuffix = switch ("${{ matrix.platform }}") {
          "x86" { "" }
          "x64" { "64" }
          "ARM64" { "_arm64" }
          default { "64" }
        }
        
        .\vcpkg\vcpkg.exe install --triplet $triplet
        echo "VCPKG_INSTALLED_DIR=$PWD\vcpkg\installed" >> $env:GITHUB_ENV
        echo "VCPKG_TARGET_TRIPLET=$triplet" >> $env:GITHUB_ENV
        echo "MSBUILD_PLATFORM=$msbuildPlatform" >> $env:GITHUB_ENV
        echo "LIB_SUFFIX=$libSuffix" >> $env:GITHUB_ENV
        .\vcpkg\vcpkg.exe list

        # 플랫폼별 Detours 라이브러리 이름 결정
        $detoursLibName = switch ("${{ matrix.platform }}") {
          "x86" { "detours.lib" }
          "x64" { "detours.lib" }  # vcpkg에서는 보통 detours.lib로 통일
          "ARM64" { "detours.lib" }
          default { "detours.lib" }
        }

        # vcpkg 라이브러리 설치 확인
        $vcpkgLibPath = "$PWD\vcpkg\installed\$triplet\lib"
        Write-Host "vcpkg 라이브러리 경로 확인: $vcpkgLibPath" -ForegroundColor Green
        if (Test-Path $vcpkgLibPath) {
          Get-ChildItem $vcpkgLibPath -Filter *.lib | ForEach-Object {
            Write-Host "  - $($_.Name)" -ForegroundColor Cyan
          }
        } else {
          Write-Host "경고: vcpkg 라이브러리 경로를 찾을 수 없습니다: $vcpkgLibPath" -ForegroundColor Yellow
        }

        $libPath = "$PWD\vcpkg\installed\$triplet\lib\$detoursLibName"
        if (Test-Path $libPath) {
          Write-Host "$detoursLibName 확인됨: $libPath" -ForegroundColor Green
        } else {
          Write-Host "경고: $detoursLibName 미발견 (vcpkg installed lib)" -ForegroundColor Yellow
        }

    - name: Build FreeType (custom fork for MacType)
      run: |
        Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
        $ftDir = Join-Path $PWD "deps/freetype"
        if (!(Test-Path $ftDir)) {
          git clone https://github.com/snowie2000/freetype.git $ftDir
        }
        # 선택: 필요한 경우 MacType 패치 적용 (존재 시에만)
        if (Test-Path (Join-Path $PWD "doc/glyph_to_bitmapex.diff")) {
          try { git -C $ftDir apply (Join-Path $PWD "doc/glyph_to_bitmapex.diff") } catch { Write-Host "패치 적용 건너뜀: $($_.Exception.Message)" -ForegroundColor Yellow }
        }
        # 플랫폼별 MSBuild 플랫폼 설정 (환경변수에서 가져오기)
        $msbuildPlatform = $env:MSBUILD_PLATFORM
        if (-not $msbuildPlatform) {
          $msbuildPlatform = switch ("${{ matrix.platform }}") {
            "x86" { "Win32" }
            "x64" { "x64" }
            "ARM64" { "ARM64" }
            default { "x64" }
          }
        }

        # 플랫폼별 호스트 아키텍처 설정 (ARM64 크로스컴파일용)
        $hostArch = $env:HOST_ARCH
        if (-not $hostArch) {
          $hostArch = switch ("${{ matrix.platform }}") {
            "x86" { "x86" }
            "x64" { "x64" }
            "ARM64" { "x64" }  # ARM64는 x64 호스트에서 크로스컴파일
            default { "x64" }
          }
        }
        echo "HOST_ARCH=$hostArch" >> $env:GITHUB_ENV

        $sdkVersion = $env:WINDOWS_SDK_VERSION; if (-not $sdkVersion) { $sdkVersion = "10.0.26100.0" }
        $ftSln = Join-Path $ftDir "builds/windows/vc2010/freetype.sln"
        if (Test-Path $ftSln) {
          Write-Host "FreeType 빌드 시작: 플랫폼=$msbuildPlatform, 구성=Release" -ForegroundColor Green

          # MacType 패치 적용 확인
          Write-Host "MacType 패치 적용 확인..." -ForegroundColor Cyan
          $patchApplied = $false
          if (Test-Path (Join-Path $ftDir "src/base/ftlcdfil.c")) {
            $ftLcdFilPath = Join-Path $ftDir "src/base/ftlcdfil.c"
            if (Get-Content $ftLcdFilPath | Select-String -Pattern "FT_LCDMode_Set") {
              Write-Host "FT_LCDMode_Set 함수가 이미 포함되어 있습니다." -ForegroundColor Green
              $patchApplied = $true
            } else {
              Write-Host "FT_LCDMode_Set 함수가 없습니다. 패치를 적용합니다." -ForegroundColor Yellow
              # 패치 파일 적용
              if (Test-Path (Join-Path $PWD "doc/glyph_to_bitmapex.diff")) {
                try {
                  git -C $ftDir apply (Join-Path $PWD "doc/glyph_to_bitmapex.diff")
                  Write-Host "MacType 패치가 적용되었습니다." -ForegroundColor Green
                  $patchApplied = $true
                } catch {
                  Write-Host "패치 적용 실패: $($_.Exception.Message)" -ForegroundColor Red
                }
              } else {
                Write-Host "패치 파일이 없습니다: doc/glyph_to_bitmapex.diff" -ForegroundColor Red
              }
            }
          }

          if (-not $patchApplied) {
            Write-Host "경고: MacType 패치가 적용되지 않았습니다. FT_LCDMode_Set 함수가 누락될 수 있습니다." -ForegroundColor Red
          }

          msbuild $ftSln -p:Configuration=Release -p:Platform=$msbuildPlatform -p:WindowsTargetPlatformVersion=$sdkVersion -p:PlatformToolset=v143 -v:minimal
          
          # 플랫폼별 출력 경로 (x86 우선순위 조정)
          $platformOutputs = switch ("${{ matrix.platform }}") {
            "x86" {
              @("objs/Win32/Release/freetype.lib", "objs/Release/freetype.lib", "objs/x64/Release/freetype.lib", "objs/AMD64/Release/freetype.lib")
            }
            "x64" {
              @("objs/x64/Release/freetype.lib", "objs/AMD64/Release/freetype.lib", "objs/Win32/Release/freetype.lib", "objs/Release/freetype.lib")
            }
            "ARM64" { @("objs/ARM64/Release/freetype.lib") }
            default { @("objs/x64/Release/freetype.lib", "objs/AMD64/Release/freetype.lib") }
          }

          $picked = $null
          Write-Host "FreeType 라이브러리 검색 중..." -ForegroundColor Cyan
          foreach ($outPath in $platformOutputs) {
            $fullPath = Join-Path $ftDir $outPath
            if (Test-Path $fullPath) {
              $picked = $fullPath
              Write-Host "  찾음: $outPath" -ForegroundColor Green
              break
            } else {
              Write-Host "  없음: $outPath" -ForegroundColor Gray
            }
          }

          # 플랫폼별 경로에서 찾지 못한 경우 일반 검색
          if (-not $picked) {
            Write-Host "플랫폼별 경로에서 찾지 못함, 전체 검색 시도..." -ForegroundColor Yellow
            $cand = Get-ChildItem -Path $ftDir -Recurse -Include freetype.lib -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($cand) {
              $picked = $cand.FullName
              Write-Host "  일반 검색으로 찾음: $picked" -ForegroundColor Green
            }
          }
          if ($picked) {
            # 플랫폼별 라이브러리 이름 결정
            $freetypeLibName = switch ("${{ matrix.platform }}") {
              "x86" { "freetype.lib" }
              "x64" { "freetype64.lib" }
              "ARM64" { "freetype_arm64.lib" }
              default { "freetype.lib" }
            }
            Copy-Item $picked (Join-Path $PWD "lib/$freetypeLibName") -Force
            Write-Host "$freetypeLibName 복사 완료: lib/$freetypeLibName" -ForegroundColor Green
          } else {
            Write-Host "경고: freetype.lib 산출물 찾기 실패" -ForegroundColor Red
          }
        } else {
          Write-Host "경고: FreeType VS 솔루션 파일을 찾을 수 없습니다: $ftSln" -ForegroundColor Yellow
        }

    - name: Build modern dependencies (vcpkg-based)
      run: |
        Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
        .\scripts\build-modern-dependencies.ps1 -Platform ${{ matrix.platform }} -Configuration Release
        echo "CMAKE_TOOLCHAIN_FILE=$PWD/vcpkg/scripts/buildsystems/vcpkg.cmake" >> $env:GITHUB_ENV
        # Detours 라이브러리 복사 (vcpkg에서)
        $detoursLibName = switch ("${{ matrix.platform }}") {
          "x86" { "detours.lib" }
          "x64" { "detours.lib" }
          "ARM64" { "detours.lib" }
          default { "detours.lib" }
        }
        $vcpkgDetoursPath = "$PWD\vcpkg\installed\$env:VCPKG_TARGET_TRIPLET\lib\$detoursLibName"
        if (Test-Path $vcpkgDetoursPath) {
          Copy-Item $vcpkgDetoursPath "$PWD\lib\$detoursLibName" -Force
          Write-Host "lib\\$detoursLibName 복사 완료" -ForegroundColor Green
        } else {
          Write-Host "경고: $detoursLibName 없음 (vcpkg에서 찾을 수 없음)" -ForegroundColor Yellow
        }
        # 플랫폼별 vcpkg fallback
        $triplet = $env:VCPKG_TARGET_TRIPLET
        $vcpkgFreetypePath = "$PWD\vcpkg\installed\$triplet\lib\freetype.lib"

        # 플랫폼별 FreeType 라이브러리 이름 결정
        $freetypeLibName = switch ("${{ matrix.platform }}") {
          "x86" { "freetype.lib" }
          "x64" { "freetype64.lib" }
          "ARM64" { "freetype_arm64.lib" }
          default { "freetype.lib" }
        }

        if (!(Test-Path "$PWD\lib\$freetypeLibName") -and (Test-Path $vcpkgFreetypePath)) {
          Copy-Item $vcpkgFreetypePath "$PWD\lib\$freetypeLibName" -Force
          Write-Host "$freetypeLibName 복사 완료(vcpkg $triplet)" -ForegroundColor Green
        } else {
          if (!(Test-Path "$PWD\lib\$freetypeLibName")) {
            Write-Host "경고: $freetypeLibName 미발견 (fork/vcpkg 모두)" -ForegroundColor Yellow
          }
        }
        dir lib | findstr detours || echo "lib 폴더 내용 나열 완료"

    - name: Setup JSON configuration
      run: |
        Write-Host "JSON 기반 설정 시스템 사용 - IniParser 불필요" -ForegroundColor Green
        Write-Host "모든 설정이 JSON 파일로 관리됩니다." -ForegroundColor Cyan

    - name: Build MacType (Rel+Detours)
      run: |
        # 플랫폼별 MSBuild 플랫폼 설정 (환경변수에서 가져오기)
        $msbuildPlatform = $env:MSBUILD_PLATFORM
        if (-not $msbuildPlatform) {
          $msbuildPlatform = switch ("${{ matrix.platform }}") {
            "x86" { "Win32" }
            "x64" { "x64" }
            "ARM64" { "ARM64" }
            default { "x64" }
          }
        }
        
        $sdkVersion = $env:WINDOWS_SDK_VERSION; if (-not $sdkVersion) { $sdkVersion = "10.0.26100.0" }
        echo "사용할 Windows SDK 버전: $sdkVersion"
        echo "빌드 플랫폼: ${{ matrix.platform }} (MSBuild: $msbuildPlatform)"
        echo "vcpkg triplet: $env:VCPKG_TARGET_TRIPLET"
        echo "lib 폴더 내용 확인:"
        Get-ChildItem lib -Filter *.lib -ErrorAction SilentlyContinue | ForEach-Object {
          echo "  - $($_.Name)"
        }

        Write-Host "MacType 빌드 시작: 플랫폼=$msbuildPlatform, 구성=Rel+Detours" -ForegroundColor Green

        # 플랫폼별 MSBuild 호스트 아키텍처 설정
        $msbuildHostArch = switch ("${{ matrix.platform }}") {
          "x86" { "x86" }
          "x64" { "x64" }
          "ARM64" { "x64" }  # ARM64는 x64 호스트에서 크로스컴파일
          default { "x64" }
        }

        Write-Host "MSBuild 호스트 아키텍처: $msbuildHostArch" -ForegroundColor Cyan

        msbuild ${{ env.SOLUTION_FILE_PATH }} -p:Configuration="Rel+Detours" -p:Platform=$msbuildPlatform -p:WindowsTargetPlatformVersion=$sdkVersion -p:UseMultiToolTask=true -p:EnforceProcessCountAcrossBuilds=true /v:n /fl "/flp:logfile=msbuild-RelDetours-${{ matrix.platform }}.log;verbosity=normal" /p:PreferredToolArchitecture=$msbuildHostArch

    - name: Verify build artifacts architecture
      run: |
        Write-Host "빌드 산출물 아키텍처 검증 시작..." -ForegroundColor Green
        Write-Host "플랫폼: ${{ matrix.platform }}" -ForegroundColor Cyan

        # 플랫폼별 예상 MACHINE 값
        $expectedMachine = switch ("${{ matrix.platform }}") {
          "x86" { "0x014C" }  # IMAGE_FILE_MACHINE_I386
          "x64" { "0x8664" }  # IMAGE_FILE_MACHINE_AMD64
          "ARM64" { "0xAA64" } # IMAGE_FILE_MACHINE_ARM64
          default { "0x0000" }
        }

        Write-Host "예상 아키텍처: $expectedMachine" -ForegroundColor Yellow

        # dumpbin 경로 찾기
        $dumpbinPath = $null
        $possiblePaths = @(
          "${env:ProgramFiles(x86)}\Microsoft Visual Studio\2022\Enterprise\VC\Tools\MSVC\*\bin\Hostx64\x86\dumpbin.exe",
          "${env:ProgramFiles(x86)}\Microsoft Visual Studio\2022\Professional\VC\Tools\MSVC\*\bin\Hostx64\x86\dumpbin.exe",
          "${env:ProgramFiles(x86)}\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\*\bin\Hostx64\x86\dumpbin.exe",
          "${env:ProgramFiles}\Microsoft Visual Studio\2022\Enterprise\VC\Tools\MSVC\*\bin\Hostx64\x64\dumpbin.exe",
          "${env:ProgramFiles}\Microsoft Visual Studio\2022\Professional\VC\Tools\MSVC\*\bin\Hostx64\x64\dumpbin.exe",
          "${env:ProgramFiles}\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\*\bin\Hostx64\x64\dumpbin.exe",
          "dumpbin.exe"  # PATH에 있는 경우
        )

        foreach ($path in $possiblePaths) {
          $resolvedPaths = Resolve-Path $path -ErrorAction SilentlyContinue
          if ($resolvedPaths) {
            $dumpbinPath = $resolvedPaths[0].Path
            Write-Host "dumpbin 경로 발견: $dumpbinPath" -ForegroundColor Green
            break
          }
        }

        if (-not $dumpbinPath) {
          Write-Host "dumpbin을 찾을 수 없습니다. PATH에서 검색 중..." -ForegroundColor Yellow
          $dumpbinPath = Get-Command dumpbin.exe -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Source
          if ($dumpbinPath) {
            Write-Host "PATH에서 dumpbin 발견: $dumpbinPath" -ForegroundColor Green
          } else {
            Write-Host "❌ dumpbin을 찾을 수 없습니다. 아키텍처 검증을 건너뜁니다." -ForegroundColor Red
            Write-Host "✅ 빌드 산출물 아키텍처 검증 건너뜀 (dumpbin 없음)" -ForegroundColor Yellow
            exit 0
          }
        }

        # DLL과 EXE 파일들 찾기
        $dllFiles = Get-ChildItem -Path "Rel+Detours" -Filter "*.dll" -Recurse
        $exeFiles = Get-ChildItem -Path "Rel+Detours" -Filter "*.exe" -Recurse

        $allFiles = @($dllFiles) + @($exeFiles)
        $verificationPassed = $true

        foreach ($file in $allFiles) {
          Write-Host "검증 중: $($file.Name)" -ForegroundColor Gray

          # dumpbin으로 PE 헤더 정보 확인
          $dumpbinOutput = & $dumpbinPath /headers "$($file.FullName)" 2>&1

          # MACHINE 값 추출
          $machineLine = $dumpbinOutput | Where-Object { $_ -match "machine \(x86\)|machine \(x64\)|machine \(ARM64\)" }
          if ($machineLine) {
            $actualMachine = if ($machineLine -match "machine \(x86\)") { "0x014C" }
                            elseif ($machineLine -match "machine \(x64\)") { "0x8664" }
                            elseif ($machineLine -match "machine \(ARM64\)") { "0xAA64" }
                            else { "UNKNOWN" }

            Write-Host "  실제 아키텍처: $actualMachine" -ForegroundColor Cyan

            if ($actualMachine -eq $expectedMachine) {
              Write-Host "  ✅ 아키텍처 일치" -ForegroundColor Green
            } else {
              Write-Host "  ❌ 아키텍처 불일치! 예상: $expectedMachine, 실제: $actualMachine" -ForegroundColor Red
              $verificationPassed = $false
            }
          } else {
            Write-Host "  ⚠️ 아키텍처 정보를 찾을 수 없음" -ForegroundColor Yellow
          }
        }

        if (-not $verificationPassed) {
          Write-Host "아키텍처 검증 실패! 빌드를 중단합니다." -ForegroundColor Red
          exit 1
        }

        Write-Host "✅ 모든 산출물 아키텍처 검증 완료" -ForegroundColor Green

    - name: Generate code coverage (Debug only)
      if: matrix.configuration == 'Debug'
      run: |
        Write-Host "코드 커버리지 생성 중..." -ForegroundColor Green
        # OpenCppCoverage 설치 및 사용
        choco install OpenCppCoverage -y --no-progress
        $coverageArgs = @(
          "--sources=$PWD",
          "--excluded_sources=$PWD\build",
          "--excluded_sources=$PWD\vcpkg",
          "--excluded_sources=$PWD\deps",
          "--export_type=cobertura:coverage.xml",
          "--export_type=html:$PWD\coverage-report",
          "msbuild ${{ env.SOLUTION_FILE_PATH }} -p:Configuration=Debug -p:Platform=$msbuildPlatform -p:WindowsTargetPlatformVersion=$sdkVersion -p:UseMultiToolTask=true -p:EnforceProcessCountAcrossBuilds=true /v:n /fl /flp:logfile=msbuild-coverage-${{ matrix.platform }}.log;verbosity=normal /p:PreferredToolArchitecture=$msbuildHostArch"
        )
        OpenCppCoverage $coverageArgs
      continue-on-error: true

    - name: Upload coverage reports
      if: matrix.configuration == 'Debug'
      uses: codecov/codecov-action@v4
      with:
        file: ./coverage.xml
        flags: ${{ matrix.platform }}
        name: mactype-${{ matrix.platform }}
        fail_ci_if_error: false

    - name: Upload build artifacts
      uses: actions/upload-artifact@v4
      with:
        name: mactype-${{ matrix.platform }}-builds
        path: |
          Release/**
          Rel+Detours/**
          **/*.dll
          **/*.exe
          msbuild-RelDetours-${{ matrix.platform }}.log
        retention-days: 30

  create-installer:
    name: Create Windows Installer
    runs-on: windows-latest
    needs: [build]  # 세 플랫폼 빌드가 모두 성공해야 실행
    timeout-minutes: 30

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download x86 build artifacts
      uses: actions/download-artifact@v4
      with:
        name: mactype-x86-builds
        path: artifacts/x86/

    - name: Download x64 build artifacts
      uses: actions/download-artifact@v4
      with:
        name: mactype-x64-builds
        path: artifacts/x64/



    - name: Install Inno Setup
      run: choco install innosetup --no-progress -y

    - name: Prepare installer files
      run: |
        Write-Host "세 플랫폼 빌드 파일들을 통합 installer 디렉토리로 복사..." -ForegroundColor Green

        # installer 디렉토리 생성
        New-Item -ItemType Directory -Force -Path installer/Files/x86 | Out-Null
        New-Item -ItemType Directory -Force -Path installer/Files/x64 | Out-Null

        # x86 파일들 복사
        if (Test-Path "artifacts/x86/Release") {
          Copy-Item "artifacts/x86/Release/*" "installer/Files/x86/" -Recurse -Force
        }
        if (Test-Path "artifacts/x86/Rel+Detours") {
          Copy-Item "artifacts/x86/Rel+Detours/*" "installer/Files/x86/" -Recurse -Force
        }

        # x64 파일들 복사
        if (Test-Path "artifacts/x64/Release") {
          Copy-Item "artifacts/x64/Release/*" "installer/Files/x64/" -Recurse -Force
        }
        if (Test-Path "artifacts/x64/Rel+Detours") {
          Copy-Item "artifacts/x64/Rel+Detours/*" "installer/Files/x64/" -Recurse -Force
        }



        Write-Host "Installer 파일 구조 확인:" -ForegroundColor Cyan
        Get-ChildItem installer/Files -Recurse | Select-Object FullName

    - name: Build Windows installer
      run: |
        Write-Host "Windows installer 빌드 시작..." -ForegroundColor Green

        # Windows installer 스크립트 사용
        if (Test-Path "installer/mactype-universal.iss") {
          Write-Host "MacType Windows 인스톨러 빌드 중..." -ForegroundColor Cyan
          iscc .\installer\mactype-universal.iss

          if ($LASTEXITCODE -eq 0) {
            Write-Host "✅ Windows installer 빌드 성공!" -ForegroundColor Green
            Get-ChildItem installer/Output -Name
          } else {
            Write-Host "❌ Windows installer 빌드 실패!" -ForegroundColor Red
            exit $LASTEXITCODE
          }
        } else {
          Write-Host "❌ installer/mactype-universal.iss 파일을 찾을 수 없습니다!" -ForegroundColor Red
          exit 1
        }

    - name: Upload Windows installer
      uses: actions/upload-artifact@v4
      with:
        name: mactype-windows-installer
        path: |
          installer/Output/*.exe
          installer/Output/*.msi
        retention-days: 30

  release:
    name: Create Release
    runs-on: windows-latest
    needs: [static-analysis, build, create-installer]
    if: github.event_name == 'release'
    timeout-minutes: 10

    steps:
    - name: Download all artifacts
      uses: actions/download-artifact@v4
      with:
        path: ./artifacts

    - name: Create release archive
      run: |
        Write-Host "릴리스 아카이브 생성 중..." -ForegroundColor Green

        $releaseName = "MacType-$($env:GITHUB_REF_NAME -replace 'v', '')"
        $archiveName = "$releaseName.zip"

        # 모든 아티팩트를 하나의 디렉토리로 복사
        $releaseDir = ".\release"
        New-Item -ItemType Directory -Path $releaseDir -Force

        # 빌드 아티팩트 복사
        if (Test-Path ".\artifacts\mactype-x86-builds") {
          Copy-Item ".\artifacts\mactype-x86-builds\*" $releaseDir -Recurse -Force
        }
        if (Test-Path ".\artifacts\mactype-x64-builds") {
          Copy-Item ".\artifacts\mactype-x64-builds\*" $releaseDir -Recurse -Force
        }

        # 인스톨러 복사
        if (Test-Path ".\artifacts\mactype-windows-installer") {
          Copy-Item ".\artifacts\mactype-windows-installer\*" $releaseDir -Recurse -Force
        }

        # 아카이브 생성
        Compress-Archive -Path $releaseDir\* -DestinationPath $archiveName -Force

        Write-Host "✅ 릴리스 아카이브 생성 완료: $archiveName" -ForegroundColor Green

    - name: Upload release assets
      uses: softprops/action-gh-release@v1
      with:
        files: |
          *.zip
          artifacts/mactype-windows-installer/*.exe
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  notify:
    name: Post-build Notification
    runs-on: ubuntu-latest
    needs: [static-analysis, build, create-installer]
    if: always() && github.event_name == 'push'
    timeout-minutes: 5

    steps:
    - name: Notify build status
      run: |
        echo "빌드 상태 알림:"
        echo "- 정적 분석: ${{ needs.static-analysis.result }}"
        echo "- 빌드: ${{ needs.build.result }}"
        echo "- 인스톨러: ${{ needs.create-installer.result }}"
