{
  "name": "mactype",
  "version": "2.0.0",
  "description": "Better font rendering for Windows",
  "license": "GPL-2.0",
  "homepage": "https://github.com/snowie2000/mactype",
  "documentation": "https://github.com/snowie2000/mactype/wiki",
  "maintainers": ["snowie2000"],
  "dependencies": [
    {
      "name": "freetype",
      "version>=": "2.13.2",
      "features": [
        "brotli",
        "bzip2",
        "png",
        "zlib"
      ]
    },
    {
      "name": "detours",
      "version>=": "4.0.1"
    },
    {
      "name": "nlohmann-json",
      "version>=": "3.11.3"
    },
    "zlib",
    "libpng",
    "brotli",
    "bzip2"
  ],
  "overrides": [
    {
      "name": "freetype",
      "version": "2.13.3"
    },
    {
      "name": "detours",
      "version": "4.0.1#8"
    },
    {
      "name": "nlohmann-json",
      "version": "3.11.3"
    }
  ],
  "features": {
    "test": {
      "description": "Build tests",
      "dependencies": [
        "gtest",
        "benchmark"
      ]
    },
    "examples": {
      "description": "Build examples",
      "dependencies": []
    },
    "coverage": {
      "description": "Enable code coverage instrumentation",
      "dependencies": []
    },
    "asan": {
      "description": "Enable AddressSanitizer",
      "dependencies": []
    },
    "ubsan": {
      "description": "Enable UndefinedBehaviorSanitizer",
      "dependencies": []
    }
  },
  "builtin-baseline": "f7423ee180c4b7f40d43402c2feb3859161ef625"
}
