{
  "name": "mactype",
  "version": "2.0.0",
  "description": "Better font rendering for Windows",
  "license": "GPL-2.0",
  "homepage": "https://github.com/snowie2000/mactype",
  "documentation": "https://github.com/snowie2000/mactype/wiki",
  "maintainers": ["snowie2000"],
  "dependencies": [
    {
      "name": "freetype",
      "features": [
        "brotli",
        "bzip2",
        "png",
        "zlib"
      ]
    },
    "detours",
    "nlohmann-json",
    "zlib",
    "libpng",
    "brotli",
    "bzip2",
    "gtest"
  ],

  "features": {
    "test": {
      "description": "Build tests",
      "dependencies": [
        "benchmark"
      ]
    },
    "examples": {
      "description": "Build examples",
      "dependencies": []
    },
    "coverage": {
      "description": "Enable code coverage instrumentation",
      "dependencies": []
    },
    "asan": {
      "description": "Enable AddressSanitizer",
      "dependencies": []
    },
    "ubsan": {
      "description": "Enable UndefinedBehaviorSanitizer",
      "dependencies": []
    }
  }
}
